MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/somit?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:3000
PORT=4000
JWT_SECRET=<openssl rand -hex 32 등으로 생성한 랜덤 문자열>
# NODE_ENV=production 배포 환경(Railway)에서 반드시 설정 — 없으면 크로스 도메인 쿠키(httpOnly+Secure+SameSite=None)가 전송되지 않아 로그인이 조용히 깨짐
# (로컬 개발 환경에서는 설정하지 말 것 — http://localhost는 Secure 쿠키를 받지 못함)
